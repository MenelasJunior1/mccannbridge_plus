# Next.js écoute sur 3000 et relaie uniquement /api/backend/* vers Phoenix.
PHOENIX_INTERNAL_URL=http://127.0.0.1:4000

# Phoenix utilise cette origine pour générer les liens magiques de connexion.
FRONTEND_URL=http://localhost:3000

# Assistant Phoenix + Groq (secrets serveur uniquement, jamais préfixés par NEXT_PUBLIC_).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000
RAG_MAX_OUTPUT_TOKENS=1200
RAG_MAX_CONTEXT_CHARACTERS=18000

# Activation explicite après validation Groq Zero Data Retention.
RAG_EXTERNAL_GENERATION_ENABLED=false
GROQ_ZDR_CONFIRMED=false
